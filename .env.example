# Alibaba Cloud Container Registry image and host port
IMAGE_NAME=registry.cn-hangzhou.aliyuncs.com/jiangshitong/card:latest
APP_PORT=3201

# Host mounts
APP_CONFIG_FILE=/www/docker/card/config.json
APP_DATA_DIR=/www/docker/card/data

# Application
APP_ENV=production
APP_BASE_URL=https://card.example.com
DATABASE_PATH=/app/data/card.db

# Replace all example secrets before deployment
JWT_SECRET=please-change-to-another-long-random-string

# AES-GCM and HMAC keys. Back them up separately.
CARD_ENCRYPT_KEY=please-change-card-encrypt-key-32b!!
CARD_ENCRYPT_KEY_VERSION=1
CARD_HASH_KEY=please-change-card-hmac-key
CONTACT_ENCRYPT_KEY=please-change-contact-encrypt-key
CONTACT_HASH_KEY=please-change-contact-hmac-key

# One online payment provider for registered users and guests
PAYMENT_PROVIDER=provider-name
PAYMENT_MERCHANT_ID=please-set-merchant-id
PAYMENT_MERCHANT_KEY=please-set-merchant-key
PAYMENT_TIMEOUT_MINUTES=15

# Registration email verification (only @qq.com addresses can register)
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=please-set-smtp-authorization-code
SMTP_FROM=sender@example.com
SMTP_TLS=true
REGISTRATION_CODE_HASH_KEY=please-change-registration-code-hmac-key
REGISTRATION_CODE_TTL_MINUTES=10
REGISTRATION_CODE_RESEND_SECONDS=60
REGISTRATION_CODE_MAX_ATTEMPTS=5

# Optional first-run administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=please-change-admin-password
