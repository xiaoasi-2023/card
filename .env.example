# ============================================
# 卡网 Docker 部署环境变量示例
# 复制为 .env 后修改：copy .env.example .env
# ============================================

# 阿里云镜像地址。服务器 docker compose 会直接拉这个镜像运行。
# 本地开发可先写成本地 tag，例如 card-app:latest
IMAGE_NAME=registry.cn-hangzhou.aliyuncs.com/your-namespace/card:latest

# 宿主机对外端口。容器内部固定监听 80。
APP_PORT=3000

# 运行配置与数据挂载。宝塔推荐放到站点/docker 目录，便于备份。
APP_CONFIG_FILE=/www/docker/card/config.json
APP_DATA_DIR=/www/docker/card/data

# ============================================
# 后端基础配置
# ============================================

APP_ENV=production

# 认证 / 签名密钥，必填。请改成足够长的随机字符串。
APP_AUTH_KEY=please-change-to-a-long-random-string
JWT_SECRET=please-change-to-another-long-random-string

# 卡密加密密钥（AES），丢失则历史卡密无法解密，务必备份。
# 建议 32 字节随机再 base64，或 64 位 hex。
CARD_ENCRYPT_KEY=please-change-card-encrypt-key-32b!!

# 外部访问地址，用于支付回调、邀请链接、邮件链接等。
# 本地：http://127.0.0.1:3000
# 线上：https://card.example.com
APP_BASE_URL=https://card.example.com

# ============================================
# 存储与数据库配置
# ============================================

# PostgreSQL
# 注意：容器里的 127.0.0.1 是应用容器自己，不是宿主机。
# docker-compose.yml 已映射 host.docker.internal 到宿主机，适合连接宝塔宿主机 PostgreSQL。
# 格式：postgresql://用户名:密码@host.docker.internal:5432/数据库名
DATABASE_URL=postgresql://card:your-db-password@host.docker.internal:5432/card

# Redis（库存锁、会话、队列）。同样建议宿主机或旁路容器。
REDIS_URL=redis://host.docker.internal:6379/0

# ============================================
# 业务：邀请返利 / 代理层级
# ============================================

# 被邀请人下单完成后，邀请人到账金额（元）；入账返利余额，不可提现
INVITE_REBATE_ENABLED=true
INVITE_REBATE_AMOUNT=1.00

# 子代理最大层级（总站下 L1/L2/L3）
MAX_AGENT_LEVEL=3

# ============================================
# 用户注册 / 发卡通知 SMTP
# ============================================

SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=your@163.com
SMTP_PASSWORD=your-smtp-auth-code
SMTP_FROM=your@163.com
SMTP_TLS=true

# ============================================
# 支付通道（留空则需在后台关闭对应通道）
# ============================================

# 易支付
PAYMENT_EPAY_URL=
PAYMENT_EPAY_PID=
PAYMENT_EPAY_KEY=

# Epusdt / USDT
PAYMENT_EPUSDT_URL=
PAYMENT_EPUSDT_KEY=

# ============================================
# 首次启动管理员（可选）
# ============================================

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=please-change-admin-password
